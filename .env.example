# ============================================================================
#  LLMGate — конфигурация стенда
#  Скопируйте в .env (или выполните "make env") и заполните LDAP_*.
#  Значения __GENERATE__* заменяются случайными при генерации.
#  ВАЖНО: пароли БД должны быть URL-безопасными (генератор это обеспечивает),
#  потому что из них собирается строка подключения для LiteLLM.
# ============================================================================

# Часовой пояс для логов и интерфейса
TZ=Europe/Moscow

# Адрес API, который увидят сотрудники и приложения (НЕ имя контейнера).
# Пример: http://10.10.20.15:4000/v1 или https://llm.corp.local/v1
PUBLIC_API_BASE_URL=http://192.168.1.10:4000/v1

# ---------------------------------------------------------------- PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=llmgate
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=litellm

# -------------------------------------------------------------------- LiteLLM
LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
LITELLM_MASTER_KEY=__GENERATE_SK__
# Соль хеширования ключей. ПОСЛЕ ПЕРВОГО ЗАПУСКА НЕ МЕНЯТЬ.
LITELLM_SALT_KEY=__GENERATE_SK__
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=__GENERATE__
LITELLM_LOG=INFO
LITELLM_PORT=4000

# --------------------------------------------------------------------- SGLang
# Образ должен соответствовать драйверу (nvidia-smi → CUDA Version):
#   cu130 → CUDA 13.0 (драйвер 580+)
#   cu129 → CUDA 12.9 (575+)
#   cu124 → CUDA 12.4 (550+), но это старый SGLang
# Проверка: python3 tools/llmgate.py doctor
SGLANG_IMAGE=lmsysorg/sglang:v0.5.23-cu130
# Технический ключ между LiteLLM и SGLang (SGLang его не проверяет,
# пока не задан --api-key; нужен, чтобы LiteLLM мог отправить запрос).
SGLANG_API_KEY=sk-internal
# Токен Hugging Face для gated-моделей (обычно не нужен).
HF_TOKEN=
# Ключ внешнего резервного эндпоинта (models/llm2-qwen3-32b).
REMOTE_LLM_API_KEY=

# ---------------------------------------------------------------------- Портал
PORTAL_PORT=8080
PORTAL_SESSION_KEY=__GENERATE_FERNET__
PORTAL_SESSION_TTL_HOURS=8
# true — только когда портал открыт по HTTPS (напрямую или через прокси).
PORTAL_COOKIE_SECURE=false
# IP доверенного reverse proxy, чтобы брать реальный IP из X-Forwarded-For.
# Пусто — брать адрес TCP-соединения.
PORTAL_TRUSTED_PROXIES=
PORTAL_ENV=production
LOG_LEVEL=INFO
PORTAL_LOGIN_MAX_ATTEMPTS=5
PORTAL_LOGIN_WINDOW_MINUTES=10
PORTAL_LOGIN_LOCKOUT_MINUTES=15

# --------------------------------------------------------------- LDAP / AD
LDAP_URI=ldap://dc01.corp.local:389
# true — StartTLS на порту 389. Для ldaps:// оставьте false.
LDAP_START_TLS=false
LDAP_TLS_VERIFY=true
# Сервисный аккаунт: нужны права на чтение пользователей и групп.
LDAP_BIND_DN=CN=svc-llmgate,OU=Service,DC=corp,DC=local
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=OU=Users,DC=corp,DC=local
LDAP_USER_FILTER=(&(objectClass=person)(sAMAccountName={username}))
LDAP_DISPLAY_NAME_ATTR=displayName
LDAP_EMAIL_ATTR=mail
# Атрибут групп у пользователя (AD: memberOf). Пусто — искать только по группам.
LDAP_GROUP_ATTR=memberOf
LDAP_GROUP_BASE=OU=Groups,DC=corp,DC=local
LDAP_GROUP_FILTER=(&(objectClass=group)(member={dn}))
# true — учитывать вложенные группы (AD-правило 1.2.840.113556.1.4.1941).
LDAP_NESTED_GROUPS=false
LDAP_TIMEOUT=8
